{
  "permissions": {
    "allow": [
      "Bash(./scripts/workflow.sh *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/scripts/workflow.sh status && \"${CLAUDE_PROJECT_DIR}\"/scripts/workflow.sh prompt"
          }
        ]
      }
    ]
  }
}
